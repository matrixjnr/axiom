{
  "swagger": "2.0",
  "info": {
    "title": "Notes API",
    "description": "Sample.",
    "version": "1.2.0"
  },
  "host": "api.example.com",
  "schemes": [
    "https"
  ],
  "basePath": "/v1",
  "paths": {
    "/accounts/{name}": {
      "get": {
        "summary": "Read an account",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "The account",
            "schema": {
              "$ref": "#/definitions/Account"
            }
          }
        }
      }
    },
    "/files/{path}": {
      "get": {
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": "No response is documented."
          }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "List notes",
        "description": "Newest first.",
        "operationId": "listNotes",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Filter by tags",
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "type": "string",
            "format": "uuid"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "A page of notes",
            "schema": {
              "$ref": "#/definitions/PageOfNote"
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "notes"
        ],
        "summary": "Create a note",
        "operationId": "createNote",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NewNote"
            }
          }
        ],
        "consumes": [
          "application/json",
          "application/cbor"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/Note"
            }
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "head": {
        "responses": {
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/notes/{id}": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "Read a note",
        "operationId": "readNote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Note id",
            "required": true,
            "type": "string",
            "format": "uuid"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "The note",
            "schema": {
              "$ref": "#/definitions/Note"
            }
          },
          "404": {
            "description": "No such note"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": [
          "notes"
        ],
        "summary": "Delete a note",
        "deprecated": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "key": []
          }
        ]
      }
    },
    "/tree": {
      "get": {
        "summary": "A cyclic structure",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "The tree",
            "schema": {
              "$ref": "#/definitions/Node"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Account": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "loginCount": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000
        },
        "name": {
          "type": "string",
          "format": "email"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "active",
        "loginCount",
        "name"
      ]
    },
    "NewNote": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "pattern": "[a-z ]*"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16
          },
          "maxItems": 5
        },
        "priority": {
          "$ref": "#/definitions/Priority"
        }
      },
      "required": [
        "title"
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          }
        },
        "parent": {
          "$ref": "#/definitions/Node"
        }
      }
    },
    "Note": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "$ref": "#/definitions/Priority"
        },
        "extra": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "int32"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "required": [
        "version"
      ]
    },
    "PageOfNote": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Note"
          }
        },
        "total": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "total"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": [
        "LOW",
        "HIGH"
      ]
    }
  },
  "securityDefinitions": {
    "bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    },
    "key": {
      "type": "apiKey",
      "name": "X-Api-Key",
      "in": "header"
    }
  }
}
